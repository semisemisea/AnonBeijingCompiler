# Build artifacts (any level; fuzz/ and other crate targets)
/target
**/target/
**/*.o
**/*.a
**/*.so
**/*.dylib
**/*.dll
**/*.exe
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/node_modules/

# Official prebuilt SysY runtime (tracked intentionally — do not ignore)
!sysylib/*.a
!sysylib/*.o

# Test / fuzz transient outputs
/results
fuzz/corpus/tmp/

# Tool-specific
/.docker-image
/.gem5
.DS_Store
__pycache__
/.vscode/settings.json

tools/arm-bench-web