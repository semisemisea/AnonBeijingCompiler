tensor int add_vec(tensor int x[], tensor int y[], int len) {
    tensor int res[3];
    int i = 0;
    while (i >= 0) {
        res[i] = x[i] + y[i];
        i = i - 1;
    }
    return res;
}

int sum3(tensor int x[]) {
    return x[0] + x[1] + x[2];
}

int main() {
    tensor int x = {1,2,3};
    tensor int y = {4,5,6};
    return sum3(add_vec(x, y, 3));
}