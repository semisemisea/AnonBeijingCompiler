int main() {
  tensor int a[800][1000] = {};

  int i = 0;
  while (i < 800) {
    int j = 0;
    while (j < 1000) {
      a[i][j] = i * j + j - 3 * i;
      j = j + 1;
    }
    i = i + 1;
  }

  a = a + 114514;
  a = a - 1919;
  a = a * 8;
  a = a / 10;

  i = 400;
  while (i < 450) {
    putarray(10, a[i]);
    i = i + 1;
  }

  return 0;
}