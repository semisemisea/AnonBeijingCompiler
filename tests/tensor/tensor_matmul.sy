int main() {
  tensor int a[2][3] = {};
  tensor int b[3][2] = {};
  int i = 0;
  int j = 0;

  while (i < 2) {
    while (j < 3) {
      a[i][j] = getint();
      j = j + 1;
    }
    i = i + 1;
  }
  i = 0;
  j = 0;
  while (i < 3) {
    while (j < 2) {
      b[i][j] = getint();
      j = j + 1;
    }
    i = i + 1;
  }

  tensor int c[2][2] = a @ b;
  i = 0;
  j = 0;
  while (i < 2) {
    i = i + 1;
    while (j < 2) {
      putint(c[i][j]);
      putch(32);
      j = j + 1;
    }
  }
  return 0;
}
