tensor int matmul(tensor int lhs[][99], tensor int rhs[][99], int a, int b, int c) {
  tensor int ans[99][99];

  int i = 0;
  while (i < a) {
    int flag_i = i + 1 < a;

    int k = 0;
    while (k < c) {
      int flag_k = k + 1 < c;

      int c00 = 0;
      int c01 = 0;
      int c10 = 0;
      int c11 = 0;

      int j = 0;
      while (j < b) {
        int l0 = lhs[i][j];
        int r0 = rhs[j][k];

        c00 = c00 + l0 * r0;
        if (flag_i) {
          int l1 = lhs[i + 1][j];
          c10 = c10 + l1 * r0;
          if (flag_k) {
            int r1 = rhs[j][k + 1];
            c01 = c01 + l0 * r1;
            c11 = c11 + l1 * r1;
          }
        } else if (flag_k) {
          int r1 = rhs[j][k + 1];
          c01 = c01 + l0 * r1;
        }

        j = j + 1;
      }

      ans[i][k] = c00;
      if (flag_i) {
        ans[i + 1][k] = c10;
      }
      if (flag_k) {
        ans[i][k + 1] = c01;
      }
      if (flag_i && flag_k) {
        ans[i + 1][k + 1] = c11;
      }

      k = k + 2;
    }
    i = i + 2;
  }
  return ans;
}

tensor int matmul_naive(tensor int lhs[][99], tensor int rhs[][99], int a, int b, int c) {
  tensor int ans[99][99];

  int i = 0;
  while (i < a) {
    int k = 0;
    while (k < c) {
      int j = 0;
      int sum = 0;
      while (j < b) {
        sum = sum + lhs[i][j] * rhs[j][k];
        j = j + 1;
      }
      ans[i][k] = sum;

      k = k + 1;
    }
    i = i + 1;
  }
  return ans;
}

void test() {
  int x = 99;
  int y = 99;
  int z = 99;
  tensor int a[99][99] = {};
  tensor int b[99][99] = {};

  {
    int i = 0;
    while (i < x) {
      int j = 0;
      while (j < y) {
        a[i][j] = getint();
        j = j + 1;
      }
      i = i + 1;
    }
  }

  {
    int i = 0;
    while (i < y) {
      int j = 0;
      while (j < z) {
        b[i][j] = getint();
        j = j + 1;
      }
      i = i + 1;
    }
  }

  tensor int c[99][99] = a @ b;
  // tensor int c[99][99] = matmul_naive(a, b, x, y, z);
  // tensor int c[99][99] = matmul(a, b, x, y, z);


  {
    int i = 0;
    while (i < x) {
      int j = 0;
      while (j < z) {
        if (j > 0) {
          putch(32);
        }
        putint(c[i][j]);
        j = j + 1;
      }
      putch(10);
      i = i + 1;
    }
  }
}

int main() {
  int n = getint();
  while (n > 0) {
    test();
    n = n - 1;
  }
  return 0;
}