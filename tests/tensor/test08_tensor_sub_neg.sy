int main() {
  tensor int a[4] = {1, 2, 3, 4};
  tensor int b[4] = {5, 6, 7, 8};

  tensor int c[4] = -(-a) + -b + 10;
  tensor int c0[4] = {};
  c0 = -a;
  c0 = -b;

  putarray(4, c);
  putarray(4, c0);

  tensor int d[4] = +a - -b;
  tensor int e[4] = a - - -(a - +b) + -b;
  tensor int f[4] = ((1 - a) + -(b - 2) - (1 - 2)) - a + 1 - b;

  putarray(4, d);
  putarray(4, e);
  putarray(4, f);

  return 0;
}
